{
  "name": "pica-pau-motos-ai-studio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "dev:emulador": "vite --mode emulador --port 5199",
    "preview:emulador": "vite build --mode emulador --outDir dist-emulador && vite preview --outDir dist-emulador --port 5199 --strictPort",
    "build": "vite build",
    "start": "node --import tsx scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "check:finance": "node --import tsx scripts/check-finance.ts",
    "check:inventory": "node --import tsx scripts/check-inventory.ts",
    "check:documents": "node --import tsx scripts/check-documents.ts",
    "check:import": "node --import tsx scripts/check-import.ts",
    "check:cash": "node --import tsx scripts/check-cash.ts",
    "check:permissions": "node --import tsx scripts/check-permissions.ts",
    "check:api-imports": "node --import tsx scripts/check-api-imports.ts",
    "check:mechanic": "node --import tsx scripts/check-mechanic.ts",
    "check:fleet": "node --import tsx scripts/check-fleet.ts",
    "check:removal": "node --import tsx scripts/check-removal.ts",
    "check:report": "node --import tsx scripts/check-report.ts",
    "check:stock-adjust": "node --import tsx scripts/check-stock-adjust.ts",
    "check:recurring": "node --import tsx scripts/check-recurring.ts",
    "check:firebase-errors": "node --import tsx scripts/check-firebase-errors.ts",
    "check:backup": "node --import tsx scripts/check-backup.ts",
    "check:hooks": "node --import tsx scripts/check-hooks.ts",
    "check:firestore-data": "node --import tsx scripts/check-firestore-data.ts",
    "check:number-input": "node --import tsx scripts/check-number-input.ts",
    "check:partner": "node --import tsx scripts/check-partner.ts",
    "check:barcode": "node --import tsx scripts/check-barcode.ts",
    "check:motorcycle-catalog": "node --import tsx scripts/check-motorcycle-catalog.ts",
    "check:plate": "node --import tsx scripts/check-plate.ts",
    "check:history": "node --import tsx scripts/check-history.ts",
    "check:text-case": "node --import tsx scripts/check-text-case.ts",
    "check:team-link": "node --import tsx scripts/check-team-link.ts",
    "check:pricing": "node --import tsx scripts/check-pricing.ts",
    "check:help": "node --import tsx scripts/check-help.ts",
    "check:nfe": "node --import tsx scripts/check-nfe.ts",
    "check:settings-map": "node --import tsx scripts/check-settings-map.ts",
    "e2e:emulador": "node scripts/emulador/e2e.mjs",
    "check:workspace": "node --import tsx scripts/check-workspace.ts",
    "verify": "npm run typecheck && node scripts/verify.mjs",
    "check:backfill": "tsx scripts/check-backfill.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "firebase": "12.4.0",
    "firebase-admin": "13.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/express": "4.17.23",
    "@types/node": "22.18.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.2",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
