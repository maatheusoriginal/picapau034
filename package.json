{
  "name": "pica-pau-motos-ai-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:emulador": "vite --mode emulador --port 5199",
    "preview:emulador": "vite build --mode emulador --outDir dist-emulador && vite preview --outDir dist-emulador --port 5199 --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "check:finance": "tsx scripts/check-finance.ts",
    "check:inventory": "tsx scripts/check-inventory.ts",
    "check:documents": "tsx scripts/check-documents.ts",
    "check:import": "tsx scripts/check-import.ts",
    "check:cash": "tsx scripts/check-cash.ts",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "check:api-imports": "tsx scripts/check-api-imports.ts",
    "check:mechanic": "tsx scripts/check-mechanic.ts",
    "check:backup": "tsx scripts/check-backup.ts",
    "check:hooks": "tsx scripts/check-hooks.ts",
    "check:firestore-data": "tsx scripts/check-firestore-data.ts",
    "check:number-input": "tsx scripts/check-number-input.ts",
    "check:partner": "tsx scripts/check-partner.ts",
    "check:barcode": "tsx scripts/check-barcode.ts",
    "check:motorcycle-catalog": "tsx scripts/check-motorcycle-catalog.ts",
    "check:plate": "tsx scripts/check-plate.ts",
    "check:history": "tsx scripts/check-history.ts",
    "check:text-case": "tsx scripts/check-text-case.ts",
    "check:team-link": "tsx scripts/check-team-link.ts",
    "check:pricing": "tsx scripts/check-pricing.ts",
    "check:help": "tsx scripts/check-help.ts",
    "check:nfe": "tsx scripts/check-nfe.ts",
    "e2e:emulador": "node scripts/emulador/e2e.mjs"
  },
  "dependencies": {
    "express": "4.21.2",
    "firebase": "12.4.0",
    "firebase-admin": "13.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/express": "4.17.23",
    "@types/node": "22.18.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.2",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
