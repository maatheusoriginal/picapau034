# Dependências
node_modules/

# Build de produção
dist/
# Build usado pelo roteiro ponta a ponta: servido por vite preview, sem HMR.
dist-emulador/

# Variáveis de ambiente — o JSON da conta de serviço do Firebase Admin
# NUNCA pode ir para o repositório.
.env
.env.*
!.env.example
# Só valores falsos do emulador — serve para rodar o teste ponta a ponta.
!.env.emulador

# Logs e arquivos do sistema
*.log
npm-debug.log*
.DS_Store

# Fotos e exportações que o roteiro ponta a ponta gera a cada rodada. São
# resultado de teste, não fonte: mudam a cada execução e já escapou uma vez
# um arquivo de rascunho para o repositório por causa de `git add -A`.
scripts/emulador/*.png
scripts/emulador/*.csv
