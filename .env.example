# ---------------------------------------------------------------------------
# Configuração do Firebase para o navegador (as seis são OBRIGATÓRIAS).
#
# Saem do Console do Firebase: Configurações do projeto → Geral → Seus
# aplicativos → app da Web → Configuração do SDK. Sem elas o sistema nem
# chega na tela de login: para com "Configuração do Firebase incompleta".
#
# Não são segredo — vão para dentro do navegador de qualquer visitante, é
# assim que o Firebase funciona. Quem protege os dados são as regras em
# firestore.rules, e é por isso que publicá-las importa tanto.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Credencial administrativa do servidor.
#
# É o JSON inteiro da conta de serviço (Console do Firebase → Configurações do
# projeto → Contas de serviço → Gerar nova chave privada), colado em uma linha.
#
# ISTO É CHAVE-MESTRA: quem tem este JSON lê e apaga todo o banco ignorando as
# regras do Firestore, e consegue entrar como qualquer usuário. Só nas
# variáveis de ambiente do servidor — nunca no repositório, em chat, ou em
# mensagem. Se vazar, apague a chave no Google Cloud (IAM → Contas de serviço
# → Chaves) e gere outra; apagar a antiga PRIMEIRO, porque ela funciona
# enquanto existir.
#
# Sem ela o sistema abre e opera normalmente, mas criar, editar e apagar
# usuário falham, e não dá para configurar o primeiro Super Admin.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# E-mail que pode concluir a configuração inicial e criar o primeiro
# Super Admin. Precisa ser exatamente o e-mail de login dessa pessoa.
INITIAL_SUPER_ADMIN_EMAIL=
