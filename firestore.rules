rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return signedIn() && request.auth.token.email == 'matheus2713.m@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/userAccess/$(request.auth.uid);
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profileExists() {
      return signedIn() && (exists(profilePath()) || exists(userDocPath()));
    }

    function profile() {
      return exists(profilePath()) ? get(profilePath()).data : get(userDocPath()).data;
    }

    function activeUser() {
      return isBootstrappedAdmin() || (profileExists() && profile().active != false);
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (activeUser() && profile().role == 'Super Admin');
    }

    function can(permission) {
      return isSuperAdmin() || (activeUser() && ('permissions' in profile()) && (permission in profile().permissions));
    }

    match /userAccess/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /serviceOrders/{documentId} {
      allow read: if can('orders.view') || can('budgets.view');
      allow create: if can('orders.create');
      allow update, delete: if can('orders.update');
    }

    match /products/{documentId} {
      allow read: if can('inventory.view') || can('pos.use') || can('orders.view');
      allow create, update, delete: if can('inventory.manage') || isSuperAdmin();
    }

    match /clients/{documentId} {
      allow read: if can('customers.view') || can('orders.view') || can('pos.use');
      allow create, update, delete: if can('customers.manage') || isSuperAdmin();
    }

    match /motorcycles/{documentId} {
      allow read: if can('customers.view') || can('orders.view');
      allow create, update, delete: if can('customers.manage') || isSuperAdmin();
    }

    match /expenses/{documentId} {
      allow read: if can('finance.view');
      allow create, update, delete: if can('finance.manage') || isSuperAdmin();
    }

    match /employees/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if can('team.manage') || isSuperAdmin();
    }

    match /employeeCompensation/{documentId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /partners/{documentId} {
      allow read: if can('customers.view') || can('orders.create') || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /quickServices/{documentId} {
      allow read: if can('quickService.use') || can('orders.create') || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /categories/{documentId} {
      allow read: if can('inventory.view') || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /suppliers/{documentId} {
      allow read: if can('inventory.view') || can('inventory.manage') || isSuperAdmin();
      allow create, update, delete: if can('inventory.manage') || isSuperAdmin();
    }

    match /paymentMachines/{documentId} {
      allow read: if can('finance.view') || can('pos.use') || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /paymentMethods/{documentId} {
      allow read: if can('finance.view') || can('pos.use') || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /settings/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /auditLogs/{documentId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
