rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Conta de resgate do dono da oficina. Serve apenas para o primeiro acesso
    // (ou para recuperar o sistema caso o único Super Admin seja perdido) e é
    // a mesma conta exigida em INITIAL_SUPER_ADMIN_EMAIL no servidor.
    function isBootstrappedAdmin() {
      return signedIn() && request.auth.token.email == 'matheus2713.m@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/userAccess/$(request.auth.uid);
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profileExists() {
      return signedIn() && (exists(profilePath()) || exists(userDocPath()));
    }

    function profile() {
      return exists(profilePath()) ? get(profilePath()).data : get(userDocPath()).data;
    }

    function activeUser() {
      return isBootstrappedAdmin() || (profileExists() && profile().active != false);
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (activeUser() && profile().role == 'Super Admin');
    }

    function can(permission) {
      return isSuperAdmin() || (activeUser() && ('permissions' in profile()) && (permission in profile().permissions));
    }

    // Campos que decidem quem é quem no sistema. Só o Super Admin (via console
    // ou via API administrativa, que usa o Admin SDK e não passa por estas
    // regras) pode alterá-los. Sem esta trava qualquer funcionário logado
    // conseguia gravar role:'Super Admin' no próprio documento e assumir o
    // sistema inteiro.
    function privilegeFields() {
      return ['role', 'permissions', 'active', 'employeeId', 'uid', 'email', 'createdBy', 'createdAt'];
    }

    function keepsOwnPrivileges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegeFields());
    }

    function changesOnly(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    match /userAccess/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      // O próprio usuário só pode baixar a flag de troca de senha obrigatória
      // depois de definir a senha definitiva. Todo o resto do perfil de acesso
      // é gravado pelo Super Admin.
      allow update: if isSuperAdmin()
        || (request.auth.uid == userId && changesOnly(['mustChangePassword', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      // Cada um pode corrigir os próprios dados de contato (nome, telefone),
      // nunca o cargo, as permissões ou o vínculo com o funcionário.
      allow update: if isSuperAdmin() || (request.auth.uid == userId && keepsOwnPrivileges());
      allow delete: if isSuperAdmin();
    }

    match /serviceOrders/{documentId} {
      allow read: if can('orders.view') || can('budgets.view');
      allow create: if can('orders.create');
      allow update, delete: if can('orders.update');
    }

    match /products/{documentId} {
      allow read: if can('inventory.view') || can('pos.use') || can('orders.view');
      allow create, update, delete: if can('inventory.manage');
    }

    match /clients/{documentId} {
      allow read: if can('customers.view') || can('orders.view') || can('pos.use');
      allow create, update, delete: if can('customers.manage');
    }

    match /motorcycles/{documentId} {
      allow read: if can('customers.view') || can('orders.view');
      allow create, update, delete: if can('customers.manage');
    }

    // Vendas do balcão e serviços rápidos. Quem opera o PDV registra a venda;
    // corrigir ou apagar uma venda já registrada é do financeiro.
    match /sales/{documentId} {
      allow read: if can('finance.view') || can('pos.use') || can('quickService.use');
      allow create: if can('pos.use') || can('quickService.use');
      allow update, delete: if can('finance.manage');
    }

    // Entradas de estoque (compras de peças). Quem gerencia o estoque registra;
    // corrigir ou apagar uma entrada já registrada é do financeiro, porque ela
    // mexeu no custo das peças.
    match /stockEntries/{documentId} {
      allow read: if can('inventory.view') || can('finance.view');
      allow create: if can('inventory.manage');
      allow update, delete: if can('finance.manage');
    }

    // Contas a receber e a pagar. Quem cuida do financeiro lança e dá baixa;
    // quem só consulta o financeiro enxerga sem poder mexer.
    match /accounts/{documentId} {
      allow read: if can('finance.view');
      allow create, update, delete: if can('finance.manage');
    }

    // Movimentações de dinheiro lançadas à mão (sucata, aporte, frete pago na
    // hora). Mexem no saldo e no caixa, então são do financeiro.
    match /movements/{documentId} {
      allow read: if can('finance.view');
      allow create, update: if can('finance.manage');
      allow delete: if isSuperAdmin();
    }

    // Sessões de caixa: abertura, suprimento, sangria e fechamento.
    // É o dinheiro físico da gaveta, então quem cuida do financeiro é quem
    // abre, movimenta e fecha. Quem opera o PDV consegue ler para saber se o
    // caixa está aberto, mas não mexe na conferência.
    //
    // Apagar é só do Super Admin de propósito: a conferência de um caixa
    // fechado é o registro de uma falta ou sobra, e quem causou a falta é
    // exatamente quem teria motivo para apagá-la.
    match /cashSessions/{documentId} {
      allow read: if can('finance.view') || can('pos.use');
      allow create, update: if can('finance.manage');
      allow delete: if isSuperAdmin();
    }

    match /expenses/{documentId} {
      allow read: if can('finance.view');
      allow create, update, delete: if can('finance.manage');
    }

    match /employees/{documentId} {
      allow read: if signedIn();
      // Cadastrar funcionário deixou de exigir Super Admin: era o que impedia
      // o dono de simplesmente incluir um mecânico sem também entregar o poder
      // de criar login e mudar a permissão dos outros. Salário e comissão
      // continuam em employeeCompensation, que segue só de Super Admin.
      allow create, update, delete: if can('team.manage');
    }

    match /employeeCompensation/{documentId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /partners/{documentId} {
      allow read: if can('customers.view') || can('orders.create');
      allow create, update, delete: if can('settings.manage');
    }

    match /quickServices/{documentId} {
      allow read: if can('quickService.use') || can('orders.create');
      allow create, update, delete: if can('settings.manage');
    }

    match /categories/{documentId} {
      allow read: if can('inventory.view');
      // Categoria é cadastro de rotina do balcão, não poder de administrador:
      // quem tem 'settings.manage' cria a categoria na hora, do lado do campo.
      allow create, update, delete: if can('settings.manage') || can('inventory.manage');
    }

    match /suppliers/{documentId} {
      allow read: if can('inventory.view') || can('inventory.manage');
      allow create, update, delete: if can('inventory.manage');
    }

    match /paymentMachines/{documentId} {
      allow read: if can('finance.view') || can('pos.use');
      allow create, update, delete: if can('settings.manage');
    }

    match /paymentMethods/{documentId} {
      allow read: if can('finance.view') || can('pos.use');
      allow create, update, delete: if can('settings.manage');
    }

    match /settings/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if can('settings.manage');
    }

    match /auditLogs/{documentId} {
      allow read: if isSuperAdmin();
      // Um registro de auditoria só pode ser criado em nome de quem está
      // logado, e nunca alterado ou apagado depois.
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
